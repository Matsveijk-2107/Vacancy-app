# Copy this file to .env and fill in your keys. All keys are OPTIONAL — the app
# scrapes club careers pages and ATS APIs without any key. The keys below only
# power the extra "search" layer that reaches clubs with no scrapable careers page.

# ── Adzuna (recommended) ──────────────────────────────────────────────────────
# Free job-aggregator API and the legitimate replacement for LinkedIn (which
# blocks scraping). Covers job boards across GB / IT / ES / FR / DE / NL / BE —
# i.e. most of the clubs that have no careers page of their own (incl. Italy).
# Get a free key at https://developer.adzuna.com/  (takes ~1 minute).
ADZUNA_APP_ID=your_adzuna_app_id_here
ADZUNA_APP_KEY=your_adzuna_app_key_here

# ── SerpAPI (optional, legacy) ────────────────────────────────────────────────
# No longer used for LinkedIn (blocked). Left here only for completeness.
SERPAPI_KEY=
